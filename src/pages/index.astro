---
import { Image } from 'astro:assets'

import Quote from '@/components/custom/Quote.astro'
import PostPreview from '@/components/custom/PostPreview.astro'
import { getBlogCollection, sortMDByDate } from 'astro-pure/server'
import { Button } from 'astro-pure/user'
// 本地增强版 Icon：优先查本地图标注册表（tieba/xiaohongshu/qq-group），未命中回退主题内置图标
import Icon from '@/components/custom/Icon.astro'
import PageLayout from '@/layouts/BaseLayout.astro'
import ProjectCard from '@/components/home/ProjectCard.astro'
import Section from '@/components/home/Section.astro'
import config from '@/site-config'

const MAX_POSTS = 9
// 1. 获取所有博客文章
const allPosts = await getBlogCollection()
// 2. 过滤掉 hide: true 的文章（核心修改）
const visiblePosts = allPosts.filter((post) => !post.data.hide)
// 3. 对可见文章排序并截取前 MAX_POSTS 篇
const allPostsByDate = sortMDByDate(visiblePosts).slice(0, MAX_POSTS)

const imagePath = config.logo.src
const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/*.{jpeg,jpg,png,gif,avif,webp}'
)
if (!images[imagePath])
  throw new Error(
    `"${imagePath}" does not exist in glob: "src/assets/*.{jpeg,jpg,png,gif,avif,webp}"`
  )
---

<PageLayout meta={{ title: '主页' }} highlightColor='#4B0082'>
  <main class='flex w-full flex-col items-center'>
    <section class='animate mb-10 flex flex-col items-center gap-y-7' id='content-header'>
      <Image
        src={images[imagePath]()}
        alt={config.logo.alt || 'Profile'}
        class='h-28 w-auto rounded-full border p-1'
        loading='eager'
        fetchpriority='high'
      />

      <div class='flex flex-col items-center gap-y-4'>
        <h1 class='text-3xl font-medium'>{config.author}</h1>
        {/* 社交平台图标栏：仅图标，悬停显示名称，品牌色
            视觉高度对齐：以 QQ 群图标的墨迹高度为唯一基准，其余图标用 scale
            等比缩小到同一高度，宽度随原比例自适应；scale 仅缩放视觉、不改变布局盒尺寸 */}
        <div class='flex flex-wrap items-center justify-center gap-x-5 gap-y-3'>
          <a
            href='mailto:byx2020@outlook.es'
            target='_blank'
            rel='noopener noreferrer'
            title='邮箱'
            aria-label='邮箱'
            class='text-[#0078D4] transition-opacity hover:opacity-70'
          >
            <Icon name='email' class='h-6 w-6' scale={1.0125} />
          </a>
          <a
            href='https://tieba.baidu.com/home/main?id=tb.1.a19822cf.Zehl_-_tqj0LI8cqoJoGuw'
            target='_blank'
            rel='noopener noreferrer'
            title='百度贴吧'
            aria-label='百度贴吧'
            class='text-[#306EFF] transition-opacity hover:opacity-70'
          >
            <Icon name='tieba' class='h-6 w-6' scale={0.8416} />
          </a>
          <a
            href='https://www.xiaohongshu.com/user/profile/65e42e85000000000500d20f'
            target='_blank'
            rel='noopener noreferrer'
            title='小红书'
            aria-label='小红书'
            class='text-[#FF2442] transition-opacity hover:opacity-70'
          >
            <Icon name='xiaohongshu' class='h-6 w-[48px]' scale={0.9474} />
          </a>
          <a
            href='https://space.bilibili.com/143571804'
            target='_blank'
            rel='noopener noreferrer'
            title='哔哩哔哩'
            aria-label='哔哩哔哩'
            class='text-[#FB7299] transition-opacity hover:opacity-70'
          >
            <Icon name='bilibili' class='h-6 w-6' scale={0.8733} />
          </a>
          <a
            href='https://music.163.com/#/playlist?id=619361927'
            target='_blank'
            rel='noopener noreferrer'
            title='网易云音乐'
            aria-label='网易云音乐'
            class='text-[#C20C0C] transition-opacity hover:opacity-70'
          >
            <Icon name='netease' class='h-6 w-6' scale={0.8526} />
          </a>
          <a
            href='https://steamcommunity.com/id/byx2020/'
            target='_blank'
            rel='noopener noreferrer'
            title='Steam'
            aria-label='Steam'
            class='text-[#1B2838] transition-opacity hover:opacity-70 dark:text-[#C7D5E0]'
          >
            <Icon name='steam' class='h-6 w-6' scale={0.9529} />
          </a>
          <a
            href='https://jq.qq.com/?_wv=1027&k=9StgNYMV'
            target='_blank'
            rel='noopener noreferrer'
            title='边缘星墟'
            aria-label='边缘星墟（QQ群）'
            class='text-[#12B7F5] transition-opacity hover:opacity-70'
          >
            <Icon name='qq-group' class='h-6 w-6' />
          </a>
        </div>
        <Quote class='relative flex items-center justify-center' />
      </div>
    </section>

    <div id='content' class='animate flex flex-col gap-y-10 md:w-4/5 lg:w-5/6'>
      <Section title='关于'>
        <p class='text-muted-foreground'>技术宅 / 创作者 <del>/ 信息搬运者(Q群限定)</del></p>
        <p class='text-muted-foreground'>
          一个兴趣使然的多领域业余创作者，致力于在互联网上留下更多有用的东西。
          <br />本网站主要用于整理汇总我在网上各平台公开发布的文章和作品，目前仍在升级改造中，欢迎评论留言。
        </p>
        <Button title='更多我的信息' class='w-fit self-end' href='/about' variant='ahead' />
      </Section>

      <Section title='主要'>
        <div class='grid grid-cols-1 gap-3 sm:grid-cols-2'>
          <ProjectCard
            href='/docs-ec'
            heading='EdgeCloud文档'
            subheading='自行搭建维护了六年的Q群工具型机器人，目前主要服务于起点书友群'
            imagePath='/src/assets/projects/wallhaven-gj7jee2_cr520x200.webp'
          />
          <ProjectCard
            href='http://byx2020.ysepan.com'
            heading='边缘星的杂货铺'
            subheading='早年发布汉化和地图作品的主要渠道，一个免费且无广告的分享型网盘'
            imagePath='/src/assets/projects/wh0_cr520x220.webp'
          />
          <ProjectCard
            href='https://bbs.ra2ol.com/mapcenter/author.php?aid=68'
            heading='红警2尤复地图'
            subheading='早年制作的红警战网多人防守任务地图，战网热度5w+，欢迎游玩体验'
            imagePath='/src/assets/projects/RA2map2_cr520x200.webp'
          />
          <ProjectCard
            href='https://link.byx2020.com/_docs/scalar'
            heading='边缘短网址转换'
            subheading='基于开源项目Sink部署，主要为机器人EdgeCloud提供长链接缩短服务'
            imagePath='/src/assets/projects/sink_520x200.webp'
          />
        </div>
      </Section>

      {
        allPostsByDate.length > 0 && (
          <Section title='文章'>
            <ul class='flex flex-col gap-y-1.5 sm:gap-y-2'>
              {allPostsByDate.map((p) => (
                <li class='flex flex-col gap-x-2 sm:flex-row'>
                  <PostPreview post={p} />
                </li>
              ))}
            </ul>
            <Button title='更多我的文章' class='w-fit self-end' href='/posts' variant='ahead' />
          </Section>
        )
      }
    </div>
  </main>
</PageLayout>
